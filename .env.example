# Copy to .env and fill in. .env is gitignored and must stay that way --
# this repository is public.
#
# Every key here must match a field on Settings in src/portfolio_ai/config.py.
# Unrecognised keys are rejected at startup rather than ignored, so a typo stops
# the process with a message naming it instead of quietly doing nothing.

# local | production
ENVIRONMENT=local

# Point at the Postgres instance that has the pgvector extension.
# Locally that is not the default port -- check which one before assuming.
DATABASE_URL=postgresql://user:password@host:5433/portfolio_ai

# Owned by this project. Alembic keeps its version table in here too, rather
# than in public, which on a shared server is somebody else's space.
DB_SCHEMA=portfolio_rag

OPENAI_API_KEY=sk-replace-me

# Changing either of these invalidates every vector already stored and means a
# full re-embed, so treat them as recorded rather than adjustable.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# How many chunks retrieval pulls back. 1-100.
RETRIEVAL_TOP_K=20

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Comma separated.
CORS_ORIGINS=http://localhost:3000
