# Copy to .env and fill in. .env is gitignored and must stay that way --
# this repository is public.
#
# Every key here must match a field on Settings in src/portfolio_ai/config.py.
# Unrecognised keys are rejected at startup rather than ignored, so a typo stops
# the process with a message naming it instead of quietly doing nothing.

# local | production
ENVIRONMENT=local

# Point at the Postgres instance that has the pgvector extension.
# Locally that is not the default port -- check which one before assuming.
DATABASE_URL=postgresql://user:password@host:5433/portfolio_ai

# Owned by this project. Alembic keeps its version table in here too, rather
# than in public, which on a shared server is somebody else's space.
DB_SCHEMA=portfolio_rag

# Connections the pool may hold open. Postgres caps this server-wide across
# everything sharing the instance, so it is a share, not a private dial. 1-100.
DB_POOL_MAX_SIZE=10

OPENAI_API_KEY=sk-replace-me

# Seconds to wait on an OpenAI call, and how many times the SDK retries a
# connection error, timeout, 429 or 5xx of its own accord.
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=3

# Changing either of these invalidates every vector already stored and means a
# full re-embed, so treat them as recorded rather than adjustable.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Inputs per embeddings request. 1-2048.
EMBEDDING_BATCH_SIZE=64

# How many chunks retrieval pulls back. 1-100.
RETRIEVAL_TOP_K=20

# --- Assistant ---------------------------------------------------------------
# The models Rachel runs on. These are what the n8n workflow uses.
CHAT_MODEL=gpt-5-mini
CLASSIFIER_MODEL=gpt-5-mini

# How hard the model thinks before answering: minimal | low | medium | high.
# Leave empty to send nothing, which is what n8n does and means the model's own
# default (medium for gpt-5-mini).
#
# It is the single biggest thing either of these changes. Measured on the same
# question, 2026-09-22: default answered in 26.7s with the first word at 22.4s;
# `low` in 10.6s, first word 7.8s; `minimal` in 9.2s, first word 5.9s -- and
# cheaper each time. Whether the answers are as good is what the evals in step 5
# are for, so the shipped default stays at parity with n8n.
CLASSIFIER_REASONING_EFFORT=
CHAT_REASONING_EFFORT=

# How much of the conversation the model sees, counted in exchanges: one question
# plus its answer. 25 is n8n's setting, which also counts exchanges. 0-100.
MEMORY_WINDOW_TURNS=25

# How many times Rachel may search while answering one question before she has to
# reply with what she has. The first search is always made. 1-10.
AGENT_MAX_SEARCH_ROUNDS=3

# --- Ingestion source --------------------------------------------------------
# The repository ingestion reads from, and the only folder it indexes. Widening
# GITHUB_DOCS_PATH is a decision with consequences -- the answer to "the assistant
# could not answer that" is a new article, not a bigger crawl.
GITHUB_REPO=mmihaylov94/my-portfolio
GITHUB_BRANCH=main
GITHUB_DOCS_PATH=knowledgebase

# Optional. Unauthenticated GitHub API calls are capped at 60 per hour per IP and
# a run makes one, so this is headroom -- until the repository is private, when it
# becomes required. Leave unset to go without.
# GITHUB_TOKEN=

# --- Ingestion behaviour -----------------------------------------------------
# Files fetched at once. Politeness to raw.githubusercontent.com, not throughput.
INGESTION_CONCURRENCY=5

# The purge guard. Ingestion deletes any document it did not see this run, which
# is how a deleted file leaves the index -- and exactly how a partial GitHub
# failure would wipe the knowledge base.
#
# The limit is a share of what is stored rather than a fixed count, so it keeps
# working as the corpus grows: 0.3 allows removing ~a third in one run. At 11
# documents that is 4; at 50 it is 15.
INGESTION_MAX_PURGE_FRACTION=0.3

# ...with a floor, so a small corpus is not frozen -- a third of three documents
# is one, and refusing to let anyone delete a single article would be absurd.
# This many deletions are always allowed, whatever the share works out to.
INGESTION_PURGE_GRACE=2

# --- API ---------------------------------------------------------------------
# Both required by the API, which will not start without them, and by nothing
# else -- the worker and the terminal chat run with these left empty. At least 32
# characters each. Generate each with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# PORTFOLIO_AI_API_KEY is the bearer token the portfolio's Express API sends; the
# same value goes in its own .env. IP_HASH_SALT is the key visitors' addresses are
# hashed with before they are stored. Changing it later makes old and new hashes
# of the same address differ, which only matters to analytics.
PORTFOLIO_AI_API_KEY=
IP_HASH_SALT=

# Questions one conversation may ask in a rolling window of this many minutes.
SESSION_RATE_LIMIT=20
SESSION_RATE_WINDOW_MINUTES=15

# Answers being written at once, across all visitors. 1-100.
MAX_CONCURRENT_TURNS=10

# The most visitors can spend in any 24 hours, in dollars. Past it, messages get a
# polite "back tomorrow" instead of an answer. 1.00 is about 250 knowledge-base
# answers at the default settings. 0 turns the chat off without a deploy.
DAILY_SPEND_CAP_USD=1.00

# --- Retention ---------------------------------------------------------------
# Days chat messages and their feedback are kept before the nightly purge
# deletes them. 0 turns the purge off, which it then reports every night.
CHAT_RETENTION_DAYS=90

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
